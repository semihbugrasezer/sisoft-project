TELEGRAM_BOT_TOKEN=your_botfather_token_here
# 'ollama' (varsayılan): Ollama'nın kendi /api/chat'i. 'openai_compatible':
# /v1/chat/completions üzerinden LM Studio, vLLM veya Ollama'nın kendi OpenAI-uyumlu
# ucuyla konuşur. OLLAMA_BASE_URL/OLLAMA_MODEL her iki backend için de kullanılır.
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# openai_compatible backend'i için isteğe bağlı — lokal LM Studio/vLLM'de genelde
# gerekmez, uzak/korumalı bir uç için Bearer token olarak kullanılır.
LLM_API_KEY=
# İsteğe bağlı: intent-classification (kriter mi/sohbet mi) için ayrı/daha hızlı bir
# model. Boş bırakılırsa OLLAMA_MODEL kullanılır, davranış değişmez.
OLLAMA_INTENT_MODEL=
# Tek yerel Ollama sunucusuna aynı anda gidebilecek istek sayısı. Telegram
# concurrent_updates(8) ile eşzamanlı update kabul eder ama model tek instance'da
# çalışır; bu limit istek kuyruğunun kontrolsüz büyümesini önler.
OLLAMA_MAX_CONCURRENCY=3
DB_PATH=sisoft.db
LLM_TIMEOUT=600
