TELEGRAM_BOT_TOKEN=your_botfather_token_here
# Motor seçimi. Varsayılan yapılandırma yerel-öncelikli (localhost); bulut
# servisi veya API anahtarı gerektirmez. LLM_BASE_URL uzak bir sunucuya da
# yönlendirilebilir — o durumda CV içeriği o sunucuya gider (bkz. SECURITY.md).
#
#   'ollama' (varsayılan)  -> Ollama'nın kendi /api/chat ucu
#     LLM_BASE_URL=http://localhost:11434
#     LLM_MODEL=qwen2.5:7b
#
#   'openai_compatible'    -> /v1/chat/completions protokolü. Bu bir PROTOKOL
#     adıdır, OpenAI servisi DEĞİLDİR: LM Studio ve vLLM kendi yerel
#     sunucularını bu biçimde sunar.
#     LM Studio örneği (canlı doğrulandı, bkz. docs/VALIDATION.md koşu #8):
#       LLM_BASE_URL=http://localhost:1234
#       LLM_MODEL=google/gemma-4-e4b
#     vLLM örneği:
#       LLM_BASE_URL=http://localhost:8000
LLM_BACKEND=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
# openai_compatible backend'i için isteğe bağlı — lokal LM Studio/vLLM'de genelde
# gerekmez, uzak/korumalı bir uç için Bearer token olarak kullanılır.
LLM_API_KEY=
# İsteğe bağlı: intent-classification (kriter mi/sohbet mi) için ayrı/daha hızlı bir
# model. Boş bırakılırsa LLM_MODEL kullanılır, davranış değişmez.
LLM_INTENT_MODEL=
# Tek yerel LLM sunucusuna aynı anda gidebilecek istek sayısı. Telegram
# concurrent_updates(8) ile eşzamanlı update kabul eder ama model tek instance'da
# çalışır; bu limit istek kuyruğunun kontrolsüz büyümesini önler.
LLM_MAX_CONCURRENCY=3
# Ollama'ya açıkça bildirilen context penceresi (token). Gönderilmezse Ollama
# kendi varsayılanına (tipik 4096) düşer; 5 CV'lik batch üretim sırasında taşar
# ve model belgeler arası bilgi karıştırır. qwen2.5:7b 32k destekliyor.
# Daha kısa context'li bir model kullanıyorsanız bu değeri düşürün.
LLM_CONTEXT_LENGTH=32768
DB_PATH=sisoft.db
# Sohbet mesajları ve rolling summary için AÇILIŞ TEMİZLİĞİ yaş eşiği (saat).
# Temizlik yalnızca uygulama başlarken çalışır; 0 veya negatif değer kapatır.
CHAT_RETENTION_HOURS=168
# Bekleyen (henüz /analyze edilmemiş) CV'ler için AÇILIŞ TEMİZLİĞİ yaş eşiği (saat).
# Temizlik yalnızca uygulama başlarken çalışır — bu yüzden kesintisiz çalışan bir
# botta gerçek üst sınır değildir; süreç ne zaman yeniden başlarsa bu yaştan eski
# kayıtlar o an silinir. CV kişisel veridir (bkz. SECURITY.md).
# 0 veya negatif değer otomatik temizliği kapatır.
CV_RETENTION_HOURS=24
# 5 CV'lik batch analizi yerel 7B modellerde 10+ dakika sürebilir (bkz.
# docs/VALIDATION.md) — düşük tutmak evaluation adımını yarıda kesebilir.
LLM_TIMEOUT=1200
