TELEGRAM_BOT_TOKEN=your_botfather_token_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# İsteğe bağlı: intent-classification (kriter mi/sohbet mi) için ayrı/daha hızlı bir
# model. Boş bırakılırsa OLLAMA_MODEL kullanılır, davranış değişmez.
OLLAMA_INTENT_MODEL=
# Tek yerel Ollama sunucusuna aynı anda gidebilecek istek sayısı. Telegram
# concurrent_updates(8) ile eşzamanlı update kabul eder ama model tek instance'da
# çalışır; bu limit istek kuyruğunun kontrolsüz büyümesini önler.
OLLAMA_MAX_CONCURRENCY=3
DB_PATH=sisoft.db
LLM_TIMEOUT=600
